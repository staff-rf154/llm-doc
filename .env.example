APP_PORT=8091
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=docs
QDRANT_LOG_LEVEL=INFO

OLLAMA_PORT=11434

# --- Генерация -------------------------------------------------------------
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=0
SSE_HEARTBEAT=10

# --- Модель эмбеддингов и чанкинг ------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=5
EMBED_BATCH=32

# --- Исправления ответов и синонимы ---------------------------------------
CORRECTIONS_COLLECTION=corrections
CORRECTION_MATCH_THRESHOLD=0.86
CORRECTION_EXAMPLES=2
CORRECTION_OVERLAP_WORDS=2
SYNONYMS_SEED_ON_START=1
SYNONYMS_CACHE_TTL=300
SYNONYMS_MAX_VARIANTS=6

# --- Локальная модель (Ollama) ----------------------------------------------
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=-1m

# --- Обучение --------------------------------------------------------------
LESSONS_COLLECTION=lessons
LESSONS_MAX=2
LESSONS_MIN_SCORE=0.75
TRAINING_FROM_CORRECTIONS=1

# --- Автообучение ----------------------------------------------------------
AUTOLEARN_WINDOW=500
AUTOLEARN_DAYS=30
AUTOLEARN_LLM_ENABLED=1
AUTOLEARN_LLM_LIMIT=20
AUTOLEARN_TOPIC_THRESHOLD=0.84
AUTOLEARN_MIN_TOPIC_HITS=3
AUTOLEARN_MAX_TOPICS=300

# --- Генерация вопросов ----------------------------------------------------
QUESTIONGEN_COUNT=10
QUESTIONGEN_SOURCES=docs,topics,domain
QUESTIONGEN_JUDGE=1
QUESTIONGEN_VARIANTS=3
QUESTIONGEN_SIM_THRESHOLD=0.84
QUESTIONGEN_DEDUP_THRESHOLD=0.93
QUESTIONGEN_SIM_LIMIT=2000

# --- Bootstrap-обучение ----------------------------------------------------
BOOTSTRAP_CYCLES=3
BOOTSTRAP_COUNT=30
BOOTSTRAP_JUDGE=1

# --- Поведение ответа ------------------------------------------------------
PROMPTS_MAX=8
PROMPTS_CACHE_TTL=300
SYSTEM_PROMPT="Ты — помощник по внутренней документации компании и ассистент по работе с текстом. Отвечай строго на основе переданных фрагментов документации. Если во фрагментах нет ответа, прямо скажи: 'В документации нет информации по этому вопросу'. Не выдумывай факты. Отвечай на языке вопроса. Указывай источники в формате [doc:chunk]. Если пользователь спрашивает, что ты умеешь, перечисли свои возможности: работа с текстом и информацией, ответы на вопросы простыми словами, написание, редактирование, сокращение и перевод текстов, анализ документов, статей и договоров, помощь с письмами, резюме, отчётами и презентациями; поиск ответов по базе знаний продуктов со ссылками на источники. Не заявляй, что выходишь в интернет, выполняешь действия в системах или работаешь с файлами за пределами базы знаний."

# --- Индексация ------------------------------------------------------------
OMP_NUM_THREADS=12
INGEST_WORKERS=8
INGEST_BATCH_SIZE=64
INGEST_CHECKPOINT_EVERY=64

# --- Гибридный поиск и reranker ---------------------------------------------
HYBRID_SPARSE=1
HYBRID_CANDIDATES=12
RERANKER_ENABLED=1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES=10
RERANKER_MAX_LENGTH=512
RERANKER_TOP_K=5

# --- Устройство моделей поиска и сборка образа (GPU) -------------------------
# auto — GPU при наличии CUDA, иначе CPU; также cpu, cuda
EMBEDDER_DEVICE=auto
RERANKER_DEVICE=auto
# Сборка образа: cpu по умолчанию. Для NVIDIA см. docker-compose.gpu.yml,
# для Vulkan/встроенной графики — docker-compose.vulkan.yml
BASE_IMAGE=python:3.11-slim
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
OLLAMA_VULKAN=0

# --- Загрузка документов ----------------------------------------------------
UPLOAD_MAX_MB=100
UPLOAD_URL_TIMEOUT=60

# --- Обход сайтов -----------------------------------------------------------
WEB_CRAWL_MAX_PAGES=2000
WEB_CRAWL_TIMEOUT=20
WEB_CRAWL_DELAY_MS=500
WEB_CRAWL_RESPECT_ROBOTS=1
DOCS_BASE_URL=
SITE_URL=
WEB_CRAWL_USER_AGENT="Mozilla/5.0 (compatible; DocsBot/1.0)"

# --- Инфраструктура (только чтение) ----------------------------------------
# Значения по умолчанию; менять только вместе с монтированиями в compose.
# QDRANT_URL=http://qdrant:6333
# INDEX_STATE_DB=/data/index_state/index.db
# DOCS_DIR=/data/docs
# UPLOADS_DIR=/data/docs/upload
# EVAL_DIR=/data/eval
# PROMPTS_DB=/data/prompts/prompts.db
# SYNONYMS_DB=/data/synonyms/synonyms.db
# SESSION_COOKIE=sid
# SPARSE_MODEL=Qdrant/bm25
# RERANKER_BATCH=8
# HYBRID_FUSION=rrf

# --- Приложение ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
APP_TITLE="База знаний"
DOMAIN_PROFILE=general
APP_DB=/data/app/app.db
# Отдельная БД настроек (все параметры кабинета)
SETTINGS_DB=/data/settings/settings.db
SYSTEM_USERNAME=system
# Пусто — пароль создаётся при первом старте в data/app/system_password.txt
SYSTEM_PASSWORD=
