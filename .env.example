APP_PORT=8091
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=docs
QDRANT_LOG_LEVEL=INFO

OLLAMA_PORT=11434

# --- Генерация -------------------------------------------------------------
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=0

# --- Модель эмбеддингов и чанкинг ------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=5
EMBED_BATCH=32

# --- Исправления ответов и синонимы ---------------------------------------
CORRECTIONS_COLLECTION=corrections
CORRECTION_MATCH_THRESHOLD=0.86
CORRECTION_EXAMPLES=2
SYNONYMS_SEED_ON_START=1
SYNONYMS_CACHE_TTL=300
SYNONYMS_MAX_VARIANTS=6

# --- Исключения документов --------------------------------------------------
EXCLUSIONS_ENABLED=1
EXCLUSIONS_CACHE_TTL=60

# --- Изображения из документации ------------------------------------------
IMAGE_SEARCH_ENABLED=1
IMAGE_MATCH_THRESHOLD=0.75
IMAGE_MAX=2
IMAGE_MIN_SIDE=200
IMAGE_PER_PAGE=1
IMAGE_PER_DOC=20
IMAGE_SKIP_FULLPAGE=0.6

# --- Поведение ответа ------------------------------------------------------
PROMPTS_SEED_ON_START=1
PROMPTS_MAX=8
PROMPTS_CACHE_TTL=300
SYSTEM_PROMPT="Ты — помощник по внутренней документации компании и ассистент по работе с текстом. Отвечай строго на основе переданных фрагментов документации. Если в фрагментах нет ответа, прямо скажи: 'В документации нет информации по этому вопросу'. Не выдумывай факты. Отвечай на языке вопроса. Указывай источники в формате [doc:chunk]. Если пользователь спрашивает, что ты умеешь, перечисли свои возможности: работа с текстом и информацией, ответы на вопросы простыми словами, написание, редактирование, сокращение и перевод текстов, анализ документов, статей и договоров, помощь с письмами, резюме, отчётами и презентациями; поиск ответов по базе знаний продуктов со ссылками на источники. Не заявляй, что выходишь в интернет, выполняешь действия в системах или работаешь с файлами за пределами базы знаний."

# --- Индексация ------------------------------------------------------------
OMP_NUM_THREADS=12
INGEST_WORKERS=8
INGEST_BATCH_SIZE=64
INGEST_CHECKPOINT_EVERY=64

# --- Приложение ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_TITLE=База знаний company